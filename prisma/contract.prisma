// use prisma-8

enum Role {
  @@type("pg/text@1")
  ADMIN      = "ADMIN"
  MANAGER    = "MANAGER"
  DIRECTOR   = "DIRECTOR"
  SUPERVISOR = "SUPERVISOR"
  AGENT      = "AGENT"
}

enum UserStatus {
  @@type("pg/text@1")
  ACTIVE    = "ACTIVE"
  SUSPENDED = "SUSPENDED"
  ARCHIVED  = "ARCHIVED"
}

enum ContractServiceType {
  @@type("pg/text@1")
  STATIC_GUARDING = "STATIC_GUARDING"
  MOBILE_PATROL   = "MOBILE_PATROL"
  EVENT_SECURITY  = "EVENT_SECURITY"
  VIP_PROTECTION  = "VIP_PROTECTION"
  DOG_HANDLER     = "DOG_HANDLER"
}

enum ContractStatus {
  @@type("pg/text@1")
  ACTIVE     = "ACTIVE"
  EXPIRED    = "EXPIRED"
  TERMINATED = "TERMINATED"
}

enum ShiftType {
  @@type("pg/text@1")
  DAY           = "DAY"
  NIGHT         = "NIGHT"
  WEEKEND       = "WEEKEND"
  REINFORCEMENT = "REINFORCEMENT"
  DOG_PATROL    = "DOG_PATROL"
}

enum ShiftStatus {
  @@type("pg/text@1")
  SCHEDULED   = "SCHEDULED"
  IN_PROGRESS = "IN_PROGRESS"
  COMPLETED   = "COMPLETED"
  CANCELLED   = "CANCELLED"
  NO_SHOW     = "NO_SHOW"
  REPLACED    = "REPLACED"
}

enum AttendanceStatus {
  @@type("pg/text@1")
  ON_TIME         = "ON_TIME"
  LATE            = "LATE"
  ABSENT          = "ABSENT"
  EARLY_DEPARTURE = "EARLY_DEPARTURE"
  VERIFIED        = "VERIFIED"
}

enum ClockMethod {
  @@type("pg/text@1")
  QR_SCAN             = "QR_SCAN"
  GPS_GEOFENCE        = "GPS_GEOFENCE"
  SUPERVISOR_OVERRIDE = "SUPERVISOR_OVERRIDE"
}

enum PatrolStatus {
  @@type("pg/text@1")
  IN_PROGRESS = "IN_PROGRESS"
  COMPLETED   = "COMPLETED"
  INCOMPLETE  = "INCOMPLETE"
  ABORTED     = "ABORTED"
}

enum ScanStatus {
  @@type("pg/text@1")
  OK               = "OK"
  ANOMALY_DETECTED = "ANOMALY_DETECTED"
  MISSED           = "MISSED"
}

enum IncidentCategory {
  @@type("pg/text@1")
  INTRUSION         = "INTRUSION"
  FIRE_ALARM        = "FIRE_ALARM"
  THEFT             = "THEFT"
  VANDALISM         = "VANDALISM"
  AGGRESSION        = "AGGRESSION"
  TECHNICAL_FAILURE = "TECHNICAL_FAILURE"
  MEDICAL_EMERGENCY = "MEDICAL_EMERGENCY"
  ACCESS_DENIAL     = "ACCESS_DENIAL"
  SUSPICIOUS_PERSON = "SUSPICIOUS_PERSON"
  OTHER             = "OTHER"
}

enum IncidentSeverity {
  @@type("pg/text@1")
  LOW      = "LOW"
  MEDIUM   = "MEDIUM"
  HIGH     = "HIGH"
  CRITICAL = "CRITICAL"
}

enum IncidentStatus {
  @@type("pg/text@1")
  NEW         = "NEW"
  IN_PROGRESS = "IN_PROGRESS"
  RESOLVED    = "RESOLVED"
  CLOSED      = "CLOSED"
}

enum EquipmentCategory {
  @@type("pg/text@1")
  RADIO_COMMUNICATION = "RADIO_COMMUNICATION"
  LIGHTING            = "LIGHTING"
  DEFENSE_AND_PPE     = "DEFENSE_AND_PPE"
  DETECTION           = "DETECTION"
  KEYS_AND_BADGES     = "KEYS_AND_BADGES"
  PTI_DEVICE          = "PTI_DEVICE"
  VEHICLE             = "VEHICLE"
}

enum EquipmentStatus {
  @@type("pg/text@1")
  AVAILABLE         = "AVAILABLE"
  ASSIGNED          = "ASSIGNED"
  UNDER_MAINTENANCE = "UNDER_MAINTENANCE"
  DAMAGED           = "DAMAGED"
  LOST              = "LOST"
  RETIRED            = "RETIRED"
}

enum EquipmentCondition {
  @@type("pg/text@1")
  EXCELLENT = "EXCELLENT"
  GOOD      = "GOOD"
  FAIR      = "FAIR"
  DAMAGED   = "DAMAGED"
}

enum InstructionType {
  @@type("pg/text@1")
  PERMANENT           = "PERMANENT"
  TEMPORARY           = "TEMPORARY"
  EMERGENCY_PROCEDURE = "EMERGENCY_PROCEDURE"
  ACCESS_CONTROL      = "ACCESS_CONTROL"
}

enum PriorityLevel {
  @@type("pg/text@1")
  LOW    = "LOW"
  NORMAL = "NORMAL"
  HIGH   = "HIGH"
  URGENT = "URGENT"
}

enum NotificationType {
  @@type("pg/text@1")
  SOS_ALERT         = "SOS_ALERT"
  LATE_CLOCK_IN     = "LATE_CLOCK_IN"
  PATROL_MISSED     = "PATROL_MISSED"
  INCIDENT_CRITICAL = "INCIDENT_CRITICAL"
  SHIFT_ASSIGNED    = "SHIFT_ASSIGNED"
  SYSTEM            = "SYSTEM"
}

model User {
  id                  Int                   @id @default(autoincrement())
  email               String                @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  matricule           String                @unique
  role                Role
  status              UserStatus            @default(ACTIVE)
  adminLock           String?               @unique // Enforces single ADMIN (e.g. 'GLOBAL_ADMIN' only on the sole admin)
  mustChangePassword  Boolean               @default(false)
  cnapsNumber         String?               // Carte professionnelle de sécurité
  cnapsExpiration     DateTime?
  supervisorId        Int?
  teamLeaderId        Int?
  supervisor          User?                 @relation("SupervisorAgents", fields: [supervisorId], references: [id])
  supervisedAgents    User[]                @relation("SupervisorAgents")
  teamLeader          User?                 @relation("TeamLeaderAgents", fields: [teamLeaderId], references: [id])
  teamAgents          User[]                @relation("TeamLeaderAgents")
  managedSites        Site[]                @relation("SiteManager")
  supervisedSites     Site[]                @relation("SiteSupervisor")
  shifts              Shift[]               @relation("AgentShifts")
  supervisedShifts    Shift[]               @relation("SupervisorShifts")
  teamLeaderShifts    Shift[]               @relation("TeamLeaderShifts")
  attendances         Attendance[]          @relation("AgentAttendances")
  verifiedAttendances Attendance[]          @relation("SupervisorVerifiedAttendances")
  patrols             Patrol[]              @relation("AgentPatrols")
  patrolScans         PatrolScan[]          @relation("AgentPatrolScans")
  reportedIncidents   Incident[]            @relation("ReportedIncidents")
  assignedIncidents   Incident[]            @relation("AssignedIncidents")
  incidentComments    IncidentComment[]     @relation("AuthorComments")
  authoredInstructions SiteInstruction[]    @relation("AuthorInstructions")
  equipmentAssignments EquipmentAssignment[] @relation("AgentEquipmentAssignments")
  notifications       Notification[]        @relation("UserNotifications")
  roleAssignments     RoleAssignment[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())

  @@map("users")
}

model RoleAssignment {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@map("role_assignments")
}

model Client {
  id             Int              @id @default(autoincrement())
  name           String
  code           String           @unique
  contactName    String
  contactEmail   String
  contactPhone   String
  billingAddress String
  city           String
  postalCode     String
  isActive       Boolean          @default(true)
  sites          Site[]
  contracts      ClientContract[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())

  @@map("clients")
}

model ClientContract {
  id             Int       @id @default(autoincrement())
  clientId       Int
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractNumber String    @unique
  startDate      DateTime
  endDate        DateTime?
  serviceType    ContractServiceType
  status         ContractStatus      @default(ACTIVE)
  hourlyRate     Decimal?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@map("client_contracts")
}

model Site {
  id                  Int               @id @default(autoincrement())
  clientId            Int
  client              Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  managerId           Int?
  manager             User?             @relation("SiteManager", fields: [managerId], references: [id])
  supervisorId        Int?
  supervisor          User?             @relation("SiteSupervisor", fields: [supervisorId], references: [id])
  name                String
  code                String            @unique
  address             String
  city                String
  postalCode          String
  latitude            Float?
  longitude           Float?
  geofenceRadius      Int               @default(100) // radius in meters
  emergencyPhone      String?
  accessCode          String?
  generalInstructions String?
  isActive            Boolean           @default(true)
  checkpoints         Checkpoint[]
  shifts              Shift[]
  patrols             Patrol[]
  incidents           Incident[]
  siteInstructions    SiteInstruction[]
  siteEquipments      SiteEquipment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now())

  @@map("sites")
}

model Checkpoint {
  id                  Int          @id @default(autoincrement())
  siteId              Int
  site                Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name                String
  code                String
  qrCodeData          String       @unique
  nfcTagId            String?
  floorLocation       String?
  latitude            Float?
  longitude           Float?
  orderIndex          Int          @default(0)
  isRequired          Boolean      @default(true)
  scans               PatrolScan[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now())

  @@map("checkpoints")
}

model Shift {
  id                   Int                   @id @default(autoincrement())
  siteId               Int
  site                 Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  agentId              Int
  agent                User                  @relation("AgentShifts", fields: [agentId], references: [id])
  teamLeaderId         Int?
  teamLeader           User?                 @relation("TeamLeaderShifts", fields: [teamLeaderId], references: [id])
  supervisorId         Int?
  supervisor           User?                 @relation("SupervisorShifts", fields: [supervisorId], references: [id])
  title                String
  shiftType            ShiftType
  startTime            DateTime
  endTime              DateTime
  status               ShiftStatus           @default(SCHEDULED)
  hourlyRate           Decimal?
  notes                String?
  attendance           Attendance?
  patrols              Patrol[]
  incidents            Incident[]
  equipmentAssignments EquipmentAssignment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now())

  @@map("shifts")
}

model Attendance {
  id                 Int       @id @default(autoincrement())
  shiftId            Int       @unique
  shift              Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  agentId            Int
  agent              User      @relation("AgentAttendances", fields: [agentId], references: [id])
  clockInTime        DateTime
  clockInLatitude    Float?
  clockInLongitude   Float?
  clockInMethod      ClockMethod       @default(QR_SCAN)
  clockOutTime       DateTime?
  clockOutLatitude   Float?
  clockOutLongitude  Float?
  status             AttendanceStatus @default(ON_TIME)
  lateMinutes        Int       @default(0)
  verifiedById       Int?
  verifiedBy         User?     @relation("SupervisorVerifiedAttendances", fields: [verifiedById], references: [id])
  verificationNotes  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now())

  @@map("attendances")
}

model Patrol {
  id                   Int          @id @default(autoincrement())
  siteId               Int
  site                 Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  agentId              Int
  agent                User         @relation("AgentPatrols", fields: [agentId], references: [id])
  shiftId              Int?
  shift                Shift?       @relation(fields: [shiftId], references: [id])
  title                String
  scheduledStartTime   DateTime?
  startedAt            DateTime     @default(now())
  completedAt          DateTime?
  status               PatrolStatus @default(IN_PROGRESS)
  totalCheckpoints     Int          @default(0)
  scannedCheckpoints   Int          @default(0)
  notes                String?
  scans                PatrolScan[]
  incidents            Incident[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @default(now())

  @@map("patrols")
}

model PatrolScan {
  id                 Int        @id @default(autoincrement())
  patrolId           Int
  patrol             Patrol     @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  checkpointId       Int
  checkpoint         Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  agentId            Int
  agent              User       @relation("AgentPatrolScans", fields: [agentId], references: [id])
  scannedAt          DateTime   @default(now())
  latitude           Float?
  longitude          Float?
  scanMethod         String     @default("QR") // QR, NFC, MANUAL
  status             ScanStatus  @default(OK)
  anomalyDescription String?
  createdAt          DateTime   @default(now())

  @@map("patrol_scans")
}

model Incident {
  id                Int                  @id @default(autoincrement())
  siteId            Int
  site              Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shiftId           Int?
  shift             Shift?               @relation(fields: [shiftId], references: [id])
  patrolId          Int?
  patrol            Patrol?              @relation(fields: [patrolId], references: [id])
  reportedById      Int
  reportedBy        User                 @relation("ReportedIncidents", fields: [reportedById], references: [id])
  assignedToId      Int?
  assignedTo        User?                @relation("AssignedIncidents", fields: [assignedToId], references: [id])
  incidentNumber    String               @unique
  title             String
  category          IncidentCategory
  severity          IncidentSeverity     @default(MEDIUM)
  status            IncidentStatus       @default(NEW)
  occurredAt        DateTime
  reportedAt        DateTime             @default(now())
  locationDetail    String?
  description       String
  actionTaken       String?
  policeCalled      Boolean              @default(false)
  clientNotified    Boolean              @default(false)
  resolutionSummary String?
  resolvedAt        DateTime?
  attachments       IncidentAttachment[]
  comments          IncidentComment[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now())

  @@map("incidents")
}

model IncidentAttachment {
  id         Int      @id @default(autoincrement())
  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String
  fileType   String
  fileSize   Int?
  caption    String?
  uploadedAt DateTime @default(now())

  @@map("incident_attachments")
}

model IncidentComment {
  id         Int      @id @default(autoincrement())
  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId   Int
  author     User     @relation("AuthorComments", fields: [authorId], references: [id])
  comment    String
  createdAt  DateTime @default(now())

  @@map("incident_comments")
}

model Equipment {
  id                 Int                   @id @default(autoincrement())
  name               String
  code               String                @unique
  serialNumber       String?               @unique
  category           EquipmentCategory
  status             EquipmentStatus       @default(AVAILABLE)
  purchaseDate       DateTime?
  lastInspectionDate DateTime?
  assignments        EquipmentAssignment[]
  siteEquipments     SiteEquipment[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @default(now())

  @@map("equipment")
}

model EquipmentAssignment {
  id                   Int       @id @default(autoincrement())
  equipmentId          Int
  equipment            Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  agentId              Int
  agent                User      @relation("AgentEquipmentAssignments", fields: [agentId], references: [id])
  shiftId              Int?
  shift                Shift?    @relation(fields: [shiftId], references: [id])
  assignedAt           DateTime  @default(now())
  returnedAt           DateTime?
  conditionOnAssignment EquipmentCondition  @default(GOOD)
  conditionOnReturn    EquipmentCondition?
  anomalyReported      Boolean   @default(false)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  @@map("equipment_assignments")
}

model SiteInstruction {
  id             Int       @id @default(autoincrement())
  siteId         Int
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId       Int
  author         User      @relation("AuthorInstructions", fields: [authorId], references: [id])
  title          String
  content        String
  type           InstructionType @default(PERMANENT)
  priority       PriorityLevel   @default(NORMAL)
  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@map("site_instructions")
}

model SiteEquipment {
  id          Int       @id @default(autoincrement())
  siteId      Int
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  installedAt DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())

  @@unique([siteId, equipmentId])
  @@map("site_equipments")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}
