// use prisma-8

enum Role {
  @@type("pg/text@1")
  ADMIN      = "ADMIN"
  MANAGER    = "MANAGER"
  DIRECTOR   = "DIRECTOR"
  SUPERVISOR = "SUPERVISOR"
  AGENT      = "AGENT"
}

model User {
  id                  Int                   @id @default(autoincrement())
  email               String                @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  matricule           String                @unique
  role                Role
  status              String                @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  adminLock           String?               @unique // Enforces single ADMIN (e.g. 'GLOBAL_ADMIN' only on the sole admin)
  mustChangePassword  Boolean               @default(false)
  cnapsNumber         String?               // Carte professionnelle de sécurité
  cnapsExpiration     DateTime?
  supervisorId        Int?
  teamLeaderId        Int?
  supervisor          User?                 @relation("SupervisorAgents", fields: [supervisorId], references: [id])
  supervisedAgents    User[]                @relation("SupervisorAgents")
  teamLeader          User?                 @relation("TeamLeaderAgents", fields: [teamLeaderId], references: [id])
  teamAgents          User[]                @relation("TeamLeaderAgents")
  managedSites        Site[]                @relation("SiteManager")
  supervisedSites     Site[]                @relation("SiteSupervisor")
  shifts              Shift[]               @relation("AgentShifts")
  supervisedShifts    Shift[]               @relation("SupervisorShifts")
  teamLeaderShifts    Shift[]               @relation("TeamLeaderShifts")
  attendances         Attendance[]          @relation("AgentAttendances")
  verifiedAttendances Attendance[]          @relation("SupervisorVerifiedAttendances")
  patrols             Patrol[]              @relation("AgentPatrols")
  patrolScans         PatrolScan[]          @relation("AgentPatrolScans")
  reportedIncidents   Incident[]            @relation("ReportedIncidents")
  assignedIncidents   Incident[]            @relation("AssignedIncidents")
  incidentComments    IncidentComment[]     @relation("AuthorComments")
  authoredInstructions SiteInstruction[]    @relation("AuthorInstructions")
  equipmentAssignments EquipmentAssignment[] @relation("AgentEquipmentAssignments")
  notifications       Notification[]        @relation("UserNotifications")
  roleAssignments     RoleAssignment[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())

  @@map("users")
}

model RoleAssignment {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@map("role_assignments")
}

model Client {
  id             Int              @id @default(autoincrement())
  name           String
  code           String           @unique
  contactName    String
  contactEmail   String
  contactPhone   String
  billingAddress String
  city           String
  postalCode     String
  isActive       Boolean          @default(true)
  sites          Site[]
  contracts      ClientContract[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())

  @@map("clients")
}

model ClientContract {
  id             Int       @id @default(autoincrement())
  clientId       Int
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractNumber String    @unique
  startDate      DateTime
  endDate        DateTime?
  serviceType    String    // STATIC_GUARDING, MOBILE_PATROL, EVENT_SECURITY, VIP_PROTECTION, DOG_HANDLER
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED
  hourlyRate     Decimal?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@map("client_contracts")
}

model Site {
  id                  Int               @id @default(autoincrement())
  clientId            Int
  client              Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  managerId           Int?
  manager             User?             @relation("SiteManager", fields: [managerId], references: [id])
  supervisorId        Int?
  supervisor          User?             @relation("SiteSupervisor", fields: [supervisorId], references: [id])
  name                String
  code                String            @unique
  address             String
  city                String
  postalCode          String
  latitude            Float?
  longitude           Float?
  geofenceRadius      Int               @default(100) // radius in meters
  emergencyPhone      String?
  accessCode          String?
  generalInstructions String?
  isActive            Boolean           @default(true)
  checkpoints         Checkpoint[]
  shifts              Shift[]
  patrols             Patrol[]
  incidents           Incident[]
  siteInstructions    SiteInstruction[]
  siteEquipments      SiteEquipment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now())

  @@map("sites")
}

model Checkpoint {
  id                  Int          @id @default(autoincrement())
  siteId              Int
  site                Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name                String
  code                String
  qrCodeData          String       @unique
  nfcTagId            String?
  floorLocation       String?
  latitude            Float?
  longitude           Float?
  orderIndex          Int          @default(0)
  isRequired          Boolean      @default(true)
  scans               PatrolScan[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now())

  @@map("checkpoints")
}

model Shift {
  id                   Int                   @id @default(autoincrement())
  siteId               Int
  site                 Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  agentId              Int
  agent                User                  @relation("AgentShifts", fields: [agentId], references: [id])
  teamLeaderId         Int?
  teamLeader           User?                 @relation("TeamLeaderShifts", fields: [teamLeaderId], references: [id])
  supervisorId         Int?
  supervisor           User?                 @relation("SupervisorShifts", fields: [supervisorId], references: [id])
  title                String
  shiftType            String                // DAY, NIGHT, WEEKEND, REINFORCEMENT, DOG_PATROL
  startTime            DateTime
  endTime              DateTime
  status               String                @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW, REPLACED
  hourlyRate           Decimal?
  notes                String?
  attendance           Attendance?
  patrols              Patrol[]
  incidents            Incident[]
  equipmentAssignments EquipmentAssignment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now())

  @@map("shifts")
}

model Attendance {
  id                 Int       @id @default(autoincrement())
  shiftId            Int       @unique
  shift              Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  agentId            Int
  agent              User      @relation("AgentAttendances", fields: [agentId], references: [id])
  clockInTime        DateTime
  clockInLatitude    Float?
  clockInLongitude   Float?
  clockInMethod      String    @default("QR_SCAN") // QR_SCAN, GPS_GEOFENCE, SUPERVISOR_OVERRIDE
  clockOutTime       DateTime?
  clockOutLatitude   Float?
  clockOutLongitude  Float?
  status             String    @default("ON_TIME") // ON_TIME, LATE, ABSENT, EARLY_DEPARTURE, VERIFIED
  lateMinutes        Int       @default(0)
  verifiedById       Int?
  verifiedBy         User?     @relation("SupervisorVerifiedAttendances", fields: [verifiedById], references: [id])
  verificationNotes  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now())

  @@map("attendances")
}

model Patrol {
  id                   Int          @id @default(autoincrement())
  siteId               Int
  site                 Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  agentId              Int
  agent                User         @relation("AgentPatrols", fields: [agentId], references: [id])
  shiftId              Int?
  shift                Shift?       @relation(fields: [shiftId], references: [id])
  title                String
  scheduledStartTime   DateTime?
  startedAt            DateTime     @default(now())
  completedAt          DateTime?
  status               String       @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, INCOMPLETE, ABORTED
  totalCheckpoints     Int          @default(0)
  scannedCheckpoints   Int          @default(0)
  notes                String?
  scans                PatrolScan[]
  incidents            Incident[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @default(now())

  @@map("patrols")
}

model PatrolScan {
  id                 Int        @id @default(autoincrement())
  patrolId           Int
  patrol             Patrol     @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  checkpointId       Int
  checkpoint         Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  agentId            Int
  agent              User       @relation("AgentPatrolScans", fields: [agentId], references: [id])
  scannedAt          DateTime   @default(now())
  latitude           Float?
  longitude          Float?
  scanMethod         String     @default("QR") // QR, NFC, MANUAL
  status             String     @default("OK") // OK, ANOMALY_DETECTED, MISSED
  anomalyDescription String?
  createdAt          DateTime   @default(now())

  @@map("patrol_scans")
}

model Incident {
  id                Int                  @id @default(autoincrement())
  siteId            Int
  site              Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shiftId           Int?
  shift             Shift?               @relation(fields: [shiftId], references: [id])
  patrolId          Int?
  patrol            Patrol?              @relation(fields: [patrolId], references: [id])
  reportedById      Int
  reportedBy        User                 @relation("ReportedIncidents", fields: [reportedById], references: [id])
  assignedToId      Int?
  assignedTo        User?                @relation("AssignedIncidents", fields: [assignedToId], references: [id])
  incidentNumber    String               @unique
  title             String
  category          String               // INTRUSION, FIRE_ALARM, THEFT, VANDALISM, AGGRESSION, TECHNICAL_FAILURE, MEDICAL_EMERGENCY, ACCESS_DENIAL, SUSPICIOUS_PERSON, OTHER
  severity          String               @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status            String               @default("NEW") // NEW, IN_PROGRESS, RESOLVED, CLOSED
  occurredAt        DateTime
  reportedAt        DateTime             @default(now())
  locationDetail    String?
  description       String
  actionTaken       String?
  policeCalled      Boolean              @default(false)
  clientNotified    Boolean              @default(false)
  resolutionSummary String?
  resolvedAt        DateTime?
  attachments       IncidentAttachment[]
  comments          IncidentComment[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now())

  @@map("incidents")
}

model IncidentAttachment {
  id         Int      @id @default(autoincrement())
  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String
  fileType   String
  fileSize   Int?
  caption    String?
  uploadedAt DateTime @default(now())

  @@map("incident_attachments")
}

model IncidentComment {
  id         Int      @id @default(autoincrement())
  incidentId Int
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId   Int
  author     User     @relation("AuthorComments", fields: [authorId], references: [id])
  comment    String
  createdAt  DateTime @default(now())

  @@map("incident_comments")
}

model Equipment {
  id                 Int                   @id @default(autoincrement())
  name               String
  code               String                @unique
  serialNumber       String?               @unique
  category           String                // RADIO_COMMUNICATION, LIGHTING, DEFENSE_AND_PPE, DETECTION, KEYS_AND_BADGES, PTI_DEVICE, VEHICLE
  status             String                @default("AVAILABLE") // AVAILABLE, ASSIGNED, UNDER_MAINTENANCE, DAMAGED, LOST, RETIRED
  purchaseDate       DateTime?
  lastInspectionDate DateTime?
  assignments        EquipmentAssignment[]
  siteEquipments     SiteEquipment[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @default(now())

  @@map("equipment")
}

model EquipmentAssignment {
  id                   Int       @id @default(autoincrement())
  equipmentId          Int
  equipment            Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  agentId              Int
  agent                User      @relation("AgentEquipmentAssignments", fields: [agentId], references: [id])
  shiftId              Int?
  shift                Shift?    @relation(fields: [shiftId], references: [id])
  assignedAt           DateTime  @default(now())
  returnedAt           DateTime?
  conditionOnAssignment String   @default("GOOD") // EXCELLENT, GOOD, FAIR
  conditionOnReturn    String?   // EXCELLENT, GOOD, FAIR, DAMAGED
  anomalyReported      Boolean   @default(false)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  @@map("equipment_assignments")
}

model SiteInstruction {
  id             Int       @id @default(autoincrement())
  siteId         Int
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId       Int
  author         User      @relation("AuthorInstructions", fields: [authorId], references: [id])
  title          String
  content        String
  type           String    @default("PERMANENT") // PERMANENT, TEMPORARY, EMERGENCY_PROCEDURE, ACCESS_CONTROL
  priority       String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@map("site_instructions")
}

model SiteEquipment {
  id          Int       @id @default(autoincrement())
  siteId      Int
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  installedAt DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())

  @@unique([siteId, equipmentId])
  @@map("site_equipments")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("SYSTEM") // SOS_ALERT, LATE_CLOCK_IN, PATROL_MISSED, INCIDENT_CRITICAL, SHIFT_ASSIGNED, SYSTEM
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}
